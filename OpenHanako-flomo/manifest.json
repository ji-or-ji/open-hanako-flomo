{
  "manifestVersion": 1,
  "id": "openhanako-flomo",
  "name": "OpenHanako-flomo",
  "version": "0.2.0",
  "description": "浮墨笔记（flomo）接入插件 —— 写入、搜索、管理笔记",
  "minAppVersion": "0.82.0",
  "activationEvents": ["onStartup"],
  "contributes": {
    "configuration": {
      "title": "Flomo 配置",
      "properties": {
        "webhookUrl": {
          "type": "string",
          "default": "",
          "description": "flomo incoming webhook URL，从 flomo 设置 → 会员 → Incoming Webhook 获取"
        }
      }
    }
  },
  "depends": {
    "capabilities": []
  }
}
