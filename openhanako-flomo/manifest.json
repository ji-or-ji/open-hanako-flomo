{
  "manifestVersion": 2,
  "id": "openhanako-flomo",
  "name": "OpenHanako-flomo",
  "version": "2.0.1",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "description": "浮墨笔记（flomo）接入：网页版直接嵌在卡片里，写入、搜索、导入笔记，卡片上点一下就能更新自己。",
  "minAppVersion": "1.3.6-beta",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/resources.read",
    "app/runtime.execute",
    "app/runtime.local-machine",
    "app/runtime.network"
  ],
  "network": {
    "allowedHosts": ["flomoapp.com"],
    "methods": ["POST"],
    "defaultTimeoutMs": 20000,
    "maxResponseBytes": 2097152
  },
  "contributes": {
    "cards": [
      {
        "id": "flomo",
        "title": "flomo",
        "description": "网页版浮墨直接嵌在卡片里，写、翻、搜都在这一页；左下角那簇小按键里有一键更新。",
        "route": "/embed.html",
        "realization": "page",
        "siteNavEntry": true,
        "cardForm": "edge-to-edge",
        "face": { "image": "assets/cover.png" }
      }
    ],
    "settings": {
      "title": "Flomo",
      "schema": {
        "properties": {
          "webhookUrl": {
            "type": "string",
            "title": "Incoming Webhook URL",
            "description": "从 flomo 设置 → 会员 → Incoming Webhook 获取，格式 https://flomoapp.com/iwh/xxx/xxx/xxx/",
            "sensitive": true,
            "default": ""
          }
        }
      }
    }
  }
}
